rules_version = '2';
// Only the worker (Admin SDK, which bypasses these rules) uses Storage: it
// stages each Reel for Instagram to fetch through a short-lived signed URL,
// then deletes it. No client access.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
